# SUPABASE CONFIGURATION (Required)
# URL del proyecto de Supabase (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL="https://tu-proyecto-id.supabase.co"

# Clave pública anónima de Supabase (Project Settings -> API -> Project API keys -> anon / public)
# NUNCA coloques aquí la clave service_role.
VITE_SUPABASE_ANON_KEY="tu_clave_anon_publica_de_supabase"

# APP_URL: URL donde se aloja la aplicación.
APP_URL="http://localhost:3000"
